{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nigeriastack.org/schemas/v2026/modules/LGA-04.schema.json",
  "title": "LGA-04 ShopPermit submission payload (review candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "premisesRef",
    "licenceType",
    "rateCode"
  ],
  "properties": {
    "premisesRef": {
      "type": "string",
      "minLength": 1
    },
    "licenceType": {
      "type": "string",
      "minLength": 1
    },
    "rateCode": {
      "type": "string",
      "minLength": 1
    },
    "tradeCategory": {
      "type": "string"
    },
    "tradingPermitExpiry": {
      "type": "string"
    },
    "sourceAuthorityRef": {
      "type": "string",
      "minLength": 3
    },
    "changeReason": {
      "type": "string"
    },
    "proofDigestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
