{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nigeriastack.org/schemas/v2026/modules/LGA-09.schema.json",
  "title": "LGA-09 TenementRate submission payload (review candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parcelReference",
    "legalRateCode",
    "valuationBasis"
  ],
  "properties": {
    "parcelReference": {
      "type": "string",
      "minLength": 1
    },
    "legalRateCode": {
      "type": "string",
      "minLength": 1
    },
    "valuationBasis": {
      "type": "string",
      "minLength": 1
    },
    "objectionRef": {
      "type": "string"
    },
    "beneficiaryAccountRef": {
      "type": "string"
    },
    "sourceAuthorityRef": {
      "type": "string",
      "minLength": 3
    },
    "changeReason": {
      "type": "string"
    },
    "proofDigestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
