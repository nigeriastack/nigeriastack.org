{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nigeriastack.org/schemas/v2026/SubNationalServiceInteroperabilityEnvelope-CANDIDATE.schema.json",
  "title": "NigeriaStack Municipal Interoperability Envelope — reconciled core+v2.4, review candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "envelopeUlid",
    "kioskBaseDeltaId",
    "jurisdictionType",
    "stateCode",
    "councilCode",
    "moduleId",
    "pillar",
    "dimensionId",
    "channel",
    "locale",
    "hlc",
    "privacyTier",
    "issuerAuthorityRef",
    "operationState",
    "purposeCode",
    "lawfulBasis",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2026.11.24-CANDIDATE"
    },
    "envelopeUlid": {
      "type": "string",
      "pattern": "^cop_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "kioskBaseDeltaId": {
      "type": "string",
      "pattern": "^kbd_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "jurisdictionType": {
      "type": "string",
      "enum": [
        "STATE_LOCAL_GOVERNMENT",
        "FCT_AREA_COUNCIL"
      ]
    },
    "stateCode": {
      "type": "string",
      "enum": [
        "AB",
        "AD",
        "AK",
        "AN",
        "BA",
        "BY",
        "BE",
        "BO",
        "CR",
        "DE",
        "EB",
        "ED",
        "EK",
        "EN",
        "FC",
        "GO",
        "IM",
        "JI",
        "KD",
        "KN",
        "KT",
        "KE",
        "KO",
        "KW",
        "LA",
        "NA",
        "NI",
        "OG",
        "ON",
        "OS",
        "OY",
        "PL",
        "RI",
        "SO",
        "TA",
        "YO",
        "ZA"
      ]
    },
    "councilCode": {
      "type": "string",
      "pattern": "^(?:(?!FC-)[A-Z]{2}-LGA-[0-9]{2}|FC-AC-0[1-6])$"
    },
    "moduleId": {
      "type": "string",
      "enum": [
        "LGA-01",
        "LGA-02",
        "LGA-03",
        "LGA-04",
        "LGA-05",
        "LGA-06",
        "LGA-07",
        "LGA-08",
        "LGA-09",
        "LGA-10",
        "LGA-11",
        "LGA-12",
        "LGA-13",
        "LGA-14"
      ]
    },
    "pillar": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "dimensionId": {
      "type": "string",
      "enum": [
        "DIM-01",
        "DIM-02",
        "DIM-03",
        "DIM-04",
        "DIM-05",
        "DIM-06",
        "DIM-07",
        "DIM-08"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "WEB_PORTAL",
        "KIOSKBASE_OFFLINE_PWA",
        "USSD_347_LGA",
        "PAPER_COUNTER_ASSISTED",
        "TSP_PARTNER_API"
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "en-NG",
        "ha-NG",
        "yo-NG",
        "ig-NG",
        "pcm-NG"
      ]
    },
    "hlc": {
      "$ref": "#/$defs/HlcMetadata"
    },
    "privacyTier": {
      "type": "string",
      "enum": [
        "PUBLIC_MUNICIPAL_RECORD",
        "CONSENT_RESTRICTED",
        "INTERNAL_RESTRICTED_NDPA"
      ]
    },
    "issuerAuthorityRef": {
      "type": "string",
      "minLength": 3
    },
    "purposeCode": {
      "type": "string",
      "minLength": 3
    },
    "lawfulBasis": {
      "type": "string",
      "enum": [
        "CONSENT",
        "CONTRACT",
        "LEGAL_OBLIGATION",
        "VITAL_INTERESTS",
        "PUBLIC_INTEREST",
        "LEGITIMATE_INTERESTS",
        "OTHER_LEGAL_BASIS_WITH_COUNSEL_APPROVAL"
      ]
    },
    "operationState": {
      "type": "string",
      "enum": [
        "DRAFT_OFFLINE",
        "STAGED",
        "AUTHORITY_REVIEW",
        "WAITING_EXTERNAL_AUTHORITY",
        "UNKNOWN_TIMEOUT",
        "APPROVED",
        "REJECTED",
        "REVOKED",
        "CLOSED"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "clearAmTokenRef": {
      "type": "string",
      "pattern": "^clm_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "sureEvidenceSealId": {
      "type": "string",
      "pattern": "^s84_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "paymentIntentRef": {
      "type": "string",
      "minLength": 8
    },
    "bankSettlementProof": {
      "$ref": "#/$defs/DirectTreasurySettlement"
    },
    "publishIntent": {
      "type": "boolean",
      "default": false
    },
    "wasSignedByAuthority": {
      "type": "boolean",
      "default": false
    },
    "payload": {
      "type": "object"
    },
    "sourceSubmissionRef": {
      "type": "string"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 3
    }
  },
  "$defs": {
    "HlcMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalEpochMs",
        "logicalCounter",
        "nodeFingerprint",
        "driftSeconds",
        "syncState"
      ],
      "properties": {
        "physicalEpochMs": {
          "type": "integer",
          "minimum": 0
        },
        "logicalCounter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "nodeFingerprint": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "driftSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "syncState": {
          "type": "string",
          "enum": [
            "NTP_GPS_VERIFIED",
            "DEGRADED_LOCAL_HLC",
            "STAGED_AWAITING_ATTESTATION"
          ]
        },
        "localCapturedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "DirectTreasurySettlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statutoryAmountKobo",
        "platformEscrowAmountKobo",
        "stateIntermediaryEscrowKobo",
        "beneficiaryAccountRef",
        "settlementStatus",
        "bankSignedConfirmationRef",
        "confirmationVerified"
      ],
      "properties": {
        "statutoryAmountKobo": {
          "type": "integer",
          "minimum": 0
        },
        "platformEscrowAmountKobo": {
          "type": "integer",
          "const": 0
        },
        "stateIntermediaryEscrowKobo": {
          "type": "integer",
          "const": 0
        },
        "beneficiaryAccountRef": {
          "type": "string",
          "minLength": 8
        },
        "beneficiaryAuthorityRef": {
          "type": "string",
          "minLength": 8
        },
        "settlementStatus": {
          "type": "string",
          "enum": [
            "PAYMENT_INITIATED",
            "UNKNOWN_TIMEOUT",
            "SETTLED_DIRECT_TO_TREASURY",
            "REVERSED",
            "FAILED"
          ]
        },
        "bankSignedConfirmationRef": {
          "type": "string",
          "minLength": 5
        },
        "confirmationVerified": {
          "type": "boolean"
        },
        "independentBankReconciliationRef": {
          "type": "string",
          "minLength": 8
        },
        "gatewayId": {
          "type": "string",
          "minLength": 3
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "settlementStatus": {
                "const": "SETTLED_DIRECT_TO_TREASURY"
              }
            },
            "required": [
              "settlementStatus"
            ]
          },
          "then": {
            "properties": {
              "confirmationVerified": {
                "const": true
              }
            },
            "required": [
              "independentBankReconciliationRef"
            ]
          }
        }
      ]
    },
