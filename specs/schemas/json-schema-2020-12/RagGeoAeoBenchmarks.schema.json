{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nigeriastack.org/schemas/v2026/RagGeoAeoBenchmarks.schema.json",
  "title": "RagGeoAeoBenchmarks",
  "type": "object",
  "required": [
    "$schema",
    "benchmarkSuiteId",
    "totalBenchmarks",
    "maxLeadAnswerWords",
    "benchmarks"
  ],
  "properties": {
    "$schema": {
      "const": "https://nigeriastack.org/schemas/v2026/RagGeoAeoBenchmarks.schema.json"
    },
    "benchmarkSuiteId": {
      "type": "string",
      "minLength": 1
    },
    "totalBenchmarks": {
      "const": 15
    },
    "maxLeadAnswerWords": {
      "const": 65
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "benchmarkId",
          "boundRoute",
          "h2Heading",
          "leadAnswerUnder65Words",
          "primarySources",
          "wordCount"
        ],
        "properties": {
          "benchmarkId": {
            "type": "string",
            "pattern": "^RAG-H2-(0[1-9]|1[0-5])$"
          },
          "boundRoute": {
            "type": "string",
            "pattern": "^/"
          },
          "h2Heading": {
            "type": "string",
            "minLength": 1
          },
          "leadAnswerUnder65Words": {
            "type": "string",
            "minLength": 1
          },
          "primarySources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "wordCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65
          }
        }
      },
      "minItems": 15,
      "maxItems": 15
    }
  }
}
