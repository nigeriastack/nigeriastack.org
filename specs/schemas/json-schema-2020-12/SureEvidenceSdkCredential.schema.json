{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nigeriastack.org/schemas/v2026/SureEvidenceSdkCredential.schema.json",
  "title": "SureEvidenceSdkCredential",
  "description": "v2026 local JoinBody signing and verification representation. Preserve the original representation when checking signatures.",
  "type": "object",
  "required": [
    "@context",
    "credentialId",
    "type",
    "issuingAuthority",
    "deviceRegularityAttestation",
    "cryptographicSeal"
  ],
  "properties": {
    "@context": {
      "const": [
        "https://www.w3.org/ns/credentials/v2",
        "https://nigeriastack.org/contexts/sure-evidence/v2026"
      ]
    },
    "credentialId": {
      "type": "string",
      "pattern": "^s84_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "const": [
        "VerifiableCredential",
        "SureEvidenceSection84Credential"
      ]
    },
    "issuingAuthority": {
      "$ref": "https://nigeriastack.org/schemas/v2026/SureEvidenceCredential.schema.json#/properties/issuingAuthority"
    },
    "deviceRegularityAttestation": {
      "$ref": "https://nigeriastack.org/schemas/v2026/SureEvidenceCredential.schema.json#/properties/deviceRegularityAttestation"
    },
    "cryptographicSeal": {
      "type": "object",
      "required": [
        "payloadSha256Digest",
        "signatureAlgorithm",
        "signatureBase64Url",
        "issuedAtUtc"
      ],
      "properties": {
        "payloadSha256Digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signatureAlgorithm": {
          "const": "Ed25519"
        },
        "signatureBase64Url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
        },
        "issuedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
