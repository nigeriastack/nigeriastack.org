{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nigeriastack.org/schemas/v2026/KioskBaseCrdtDelta.schema.json",
  "title": "KioskBaseCrdtDelta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deltaUlid",
    "namespace",
    "hlcTimestamp",
    "clockSyncStatus",
    "visibilityTier",
    "tableName",
    "recordPrimaryKey",
    "lwwFieldPatch",
    "nodeFido2Signature"
  ],
  "properties": {
    "deltaUlid": { "type": "string", "pattern": "^kbd_[0-9A-HJKMNP-TV-Z]{26}$" },
    "namespace": { "const": "urn:ngstack:kioskbase:v2026" },
    "hlcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{13,15}:[0-9]{1,5}:[0-9a-f]{16}$"
    },
    "clockSyncStatus": { "enum": ["NTP_GPS_VERIFIED", "DEGRADED_LOCAL_HLC"] },
    "visibilityTier": {
      "enum": ["PUBLIC_OPEN_REGISTRY", "CONSENT_RESTRICTED", "INTERNAL_RESTRICTED_NDPA"]
    },
    "tableName": { "type": "string" },
    "recordPrimaryKey": { "type": "string" },
    "lwwFieldPatch": { "type": "object" },
    "nodeFido2Signature": { "type": "string" }
  }
}
