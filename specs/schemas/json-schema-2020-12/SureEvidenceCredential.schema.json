{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nigeriastack.org/schemas/v2026/SureEvidenceCredential.schema.json",
  "title": "SureEvidenceCredential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credentialUlid",
    "namespace",
    "issuingAuthority",
    "deviceRegularityAttestation",
    "documentPayload",
    "cryptographicSeal"
  ],
  "properties": {
    "credentialUlid": { "type": "string", "pattern": "^s84_[0-9A-HJKMNP-TV-Z]{26}$" },
    "namespace": { "const": "urn:ngstack:sure-evidence:v2026" },
    "issuingAuthority": {
      "type": "object",
      "required": ["jurisdictionSlug", "divisionOrDepartment", "certifyingOfficerRole", "fido2KeyId"],
      "properties": {
        "jurisdictionSlug": { "type": "string" },
        "divisionOrDepartment": { "type": "string" },
        "certifyingOfficerName": { "type": "string" },
        "certifyingOfficerRole": { "type": "string" },
        "fido2KeyId": { "type": "string" }
      }
    },
    "deviceRegularityAttestation": {
      "type": "object",
      "required": [
        "hardwareFingerprintSha256",
        "operatingConditionState",
        "monotonicSealCounter",
        "clockSyncSource",
        "statutoryDeclarationText"
      ],
      "properties": {
        "hardwareFingerprintSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "operatingConditionState": { "enum": ["NORMAL_CONTINUOUS_OPERATION", "RECOVERED_OFFLINE_SYNC"] },
        "monotonicSealCounter": { "type": "integer", "minimum": 1 },
        "clockSyncSource": { "enum": ["GPS_HARDWARE_RTC", "CELLULAR_NTP_VERIFIED"] },
        "statutoryDeclarationText": { "type": "string", "minLength": 40 }
      }
    },
    "documentPayload": {
      "type": "object",
      "required": ["referenceNumber", "documentCategory", "payloadSha256Digest"],
      "properties": {
        "referenceNumber": { "type": "string" },
        "documentCategory": { "type": "string" },
        "payloadSha256Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "cryptographicSeal": {
      "type": "object",
      "required": ["algorithm", "createdUtc", "qrVerificationUri", "signatureBase64Url"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "createdUtc": { "type": "string", "format": "date-time" },
        "qrVerificationUri": { "type": "string", "format": "uri" },
        "signatureBase64Url": { "type": "string" }
      }
    }
  }
}
