{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nigeriastack.org/schemas/v2026/ConfluenceAsyncEnvelope.schema.json",
  "title": "ConfluenceAsyncEnvelope",
  "type": "object",
  "required": [
    "operationId",
    "customerReference",
    "state",
    "acceptedAtUtc"
  ],
  "properties": {
    "operationId": {
      "type": "string",
      "pattern": "^cop_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "customerReference": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "INITIATED",
        "ACCEPTED_PENDING",
        "UNKNOWN_TIMEOUT",
        "RESOLVED_SUCCESS",
        "RESOLVED_REVERSED",
        "FAILED_TERMINAL"
      ]
    },
    "acceptedAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
