{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nigeriastack.org/schemas/v2026/ClearAmConsentEnvelope.schema.json",
  "title": "ClearAmConsentEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "consentUlid",
    "namespace",
    "dataPrincipal",
    "lawfulBasisAndPurpose",
    "dataProvidersAndScopes",
    "temporalBoundsAndExpiry",
    "cryptographicSignature"
  ],
  "properties": {
    "consentUlid": { "type": "string", "pattern": "^clm_[0-9A-HJKMNP-TV-Z]{26}$" },
    "namespace": { "const": "urn:ngstack:clearam:v2026" },
    "dataPrincipal": {
      "type": "object",
      "required": ["identifierType", "saltedIdentityHashSha256"],
      "properties": {
        "identifierType": { "enum": ["NIN", "BVN", "RC_NUMBER", "TIN", "SCN", "NHIA_ID"] },
        "saltedIdentityHashSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "lawfulBasisAndPurpose": {
      "type": "object",
      "required": ["lawfulBasis", "purposeCode", "statutoryCitation"],
      "properties": {
        "lawfulBasis": {
          "enum": [
            "EXPLICIT_DATA_SUBJECT_CONSENT",
            "STATUTORY_PUBLIC_MANDATE",
            "OPEN_COURT_PUBLIC_INTEREST",
            "CONTRACTUAL_PERFORMANCE"
          ]
        },
        "purposeCode": { "type": "string" },
        "statutoryCitation": { "type": "string" }
      }
    },
    "dataProvidersAndScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["providerCategory", "permittedScopes"],
        "properties": {
          "providerCategory": { "type": "string" },
          "permittedScopes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "temporalBoundsAndExpiry": {
      "type": "object",
      "required": ["issuedAtUtc", "validUntilUtc", "maxRetentionDays", "expiredFallbackAction"],
      "properties": {
        "issuedAtUtc": { "type": "string", "format": "date-time" },
        "validUntilUtc": { "type": "string", "format": "date-time" },
        "maxRetentionDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "expiredFallbackAction": { "const": "HTTP_403_CLEARAM_ARTIFACT_EXPIRED_ZERO_INTROSPECTION" }
      }
    },
    "cryptographicSignature": {
      "type": "object",
      "required": ["algorithm", "signerKeyId", "signatureBase64Url"],
      "properties": {
        "algorithm": { "enum": ["Ed25519", "ECDSA_P256_FIDO2"] },
        "signerKeyId": { "type": "string" },
        "signatureBase64Url": { "type": "string" }
      }
    }
  }
}
