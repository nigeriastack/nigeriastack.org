{
  "name": "nigeriastack-org-monorepo",
  "version": "2026.6.5",
  "private": true,
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "ci:g1": "node --import tsx scripts/ci/verify-cleanroom-nomenclature.ts && node scripts/ci/verify-spec-contracts.mjs",
    "ci:g2": "node scripts/ci/verify-dataset-integrity.mjs",
    "ci:g3": "node scripts/ci/verify-content-counts.mjs",
    "ci:g4-g5": "bash scripts/ci/validate-tokens.sh",
    "ci:g6": "pnpm --filter \"@nigeriastack/*\" build && pnpm --filter \"@nigeriastack/*\" test && pnpm --filter nigeriastack-org-portal build && node packages/conformance-cli/dist/cli.js certify --bb BB-01,BB-02,BB-03,BB-04,BB-05,BB-06,BB-07,BB-08,BB-09,BB-10,BB-11,BB-12 --out ./conformance-receipt.json",
    "ci:verify-all-gates": "node scripts/ci/run-verification.mjs",
    "test:telemetry": "playwright test tests/telemetry",
    "ci:opa": "opa test tests/conformance-itb/validation -v",
    "ci:release-readiness": "node scripts/ci/verify-release-readiness.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "hono": "^4.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.99.0",
    "@apidevtools/swagger-parser": "12.1.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
